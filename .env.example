# ─────────────────────────────────────────────────────────────────────────────
#  FleetMan — modèle des secrets locaux
#  1. Copier ce fichier :  cp .env.example .env
#  2. Remplir les valeurs (demander les secrets à l'équipe / portail Yowyob)
#  Le fichier .env est ignoré par git ; il est lu automatiquement par Spring Boot
#  (spring.config.import) et par docker compose. En CI/production, définir les mêmes
#  noms comme variables d'environnement ou secrets GitHub Actions.
# ─────────────────────────────────────────────────────────────────────────────

# Base PostgreSQL (docker compose + Spring)
DB_PASSWORD=
# Redis (vide en local)
REDIS_PASSWORD=

# Kernel Yowyob — clé API de la client application « fleet-management-backend »
KERNEL_API_KEY=

# Compte propriétaire Kernel (jeton de service du backend)
KERNEL_OWNER_PRINCIPAL=
KERNEL_OWNER_PASSWORD=

# Compte système Geofence
GEOFENCE_SYSTEM_PASSWORD=

# Jeton du service de notification
NOTIFICATION_SERVICE_TOKEN=

# Mot de passe démo commun (profil fake-auth, scripts de provisioning/tests)
DEMO_PASSWORD=
# Mot de passe initial d'un chauffeur créé sans mot de passe (vide = obligatoire)
DRIVER_DEFAULT_PASSWORD=

# SMTP (emails transactionnels) — optionnel
MAIL_USERNAME=
MAIL_PASSWORD=

# Base distante Yowyob (docs/db/remote.md)
REMOTE_DB_PASSWORD=
